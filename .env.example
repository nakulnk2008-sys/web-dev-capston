NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/exam_system
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_DAYS=7
BCRYPT_SALT_ROUNDS=10
CORS_ORIGIN=*
# Seconds of grace allowed after an attempt deadline for network latency on final submit
SUBMIT_GRACE_SECONDS=10
